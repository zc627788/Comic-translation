{
  "name": "comic-translation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/extension"],
  "scripts": {
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit -p apps/extension/tsconfig.json",
    "build": "node scripts/build-extension.mjs",
    "check:build": "node scripts/check-extension.mjs",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "check": "npm run check:docs && npm run typecheck && npm run build && npm run check:build",
    "test:fixtures": "node --test tests/unit/fixture-server.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
